# 复制为 .env 并填入真实值（.env 不入 Git）
# B站开放平台（https://open-live.bilibili.com）
BILI_APP_ID=0
BILI_ACCESS_KEY=your_access_key
BILI_ACCESS_SECRET=your_access_key_secret
BILI_API_HOST=https://live-open.biliapi.net

# 云端 TTS（火山引擎豆包语音，新版控制台 API Key；密钥只从本文件读取，不读系统环境变量）
# API Key 获取：火山引擎控制台 > 豆包语音 > API Key 管理
# 具体音色不在此配置：在应用「设置」界面的「云端音色」下拉框中选择
TTS_CLOUD_API_KEY=

# 云端 TTS 接入参数（以下均有内置默认值，按需取消注释覆盖）
# 服务端点（单向流式 WebSocket，见 rules/06）
#TTS_CLOUD_ENDPOINT=wss://openspeech.bytedance.com/api/v3/tts/unidirectional/stream
# 资源 ID（豆包语音合成大模型 2.0）
#TTS_CLOUD_RESOURCE_ID=seed-tts-2.0
# 音频参数（PCM 采样率 / 声道数）
#TTS_CLOUD_SAMPLE_RATE=24000
#TTS_CLOUD_CHANNELS=1
# 默认音色（用户在 UI 未选择音色时的兜底）
#TTS_CLOUD_DEFAULT_SPEAKER=zh_female_vv_uranus_bigtts
