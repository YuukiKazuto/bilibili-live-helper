# 复制为 .env 并填入真实值（.env 不入 Git）
# B站开放平台（https://open-live.bilibili.com）
BILI_APP_ID=0
BILI_ACCESS_KEY=your_access_key
BILI_ACCESS_SECRET=your_access_key_secret
BILI_API_HOST=https://live-open.biliapi.net

# 云端 TTS（火山引擎豆包语音，新版控制台 API Key；密钥只从本文件读取，不读系统环境变量）
# API Key 获取：火山引擎控制台 > 豆包语音 > API Key 管理
TTS_CLOUD_API_KEY=
# 音色 ID（可选，默认 zh_female_vv_uranus_bigtts），可在控制台「音色库」查看试听
TTS_CLOUD_SPEAKER=zh_female_vv_uranus_bigtts
